# Copy values into your host's environment settings. Do not commit real secrets.

# Reddit OAuth (recommended for reliable Reddit access)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=problem-radar/0.2 (by u/your-name)

# Optional source quota improvements
STACKEXCHANGE_KEY=
GITHUB_TOKEN=
OPENALEX_API_KEY=
OPENALEX_MAILTO=
OPENFDA_KEY=

# Bluesky public search and arXiv paper search do not require API keys.
# No general web-search fallback is configured.

# Runtime configuration
TRANSPORT=stdio
HOST=0.0.0.0
PORT=8000

# Local-only personal JSON tools. Do not enable for HTTP transports.
ENABLE_PERSONAL=0
