# Copy values into your host's environment settings. Do not commit real secrets.

# Reddit OAuth (recommended for reliable Reddit access)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=problem-radar/0.2 (by u/your-name)

# Optional source quota improvements
STACKEXCHANGE_KEY=
GITHUB_TOKEN=
OPENALEX_API_KEY=
OPENALEX_MAILTO=
OPENFDA_KEY=

# Optional official web-search fallback. Free tier currently provides 1,000 credits/month,
# requires no credit card, and stops when credits are exhausted. Never upgrade to a paid plan.
TAVILY_API_KEY=

# DuckDuckGo HTML scraping is unreliable; disabled unless explicitly opted into.
ENABLE_DDG_FALLBACK=0

# Runtime configuration
TRANSPORT=stdio
HOST=0.0.0.0
PORT=8000

# Local-only personal JSON tools. Do not enable for HTTP transports.
ENABLE_PERSONAL=0
